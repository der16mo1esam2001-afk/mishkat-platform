# Copy to .env before starting. Use different strong random values outside local experiments.
PG_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
MISHKAT_DB_PASSWORD=replace-with-another-long-random-app-password

# Local-only development identity. Never expose the development-token endpoint publicly.
ENVIRONMENT=development
AUTH_MODE=development
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_AUDIENCE=authenticated

# Production identity mode (requires a real OIDC/Supabase Auth issuer and JWKS endpoint).
# AUTH_MODE=supabase_jwks
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1

# Connectors other than NASA POWER are catalogued but not activated in this release.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
